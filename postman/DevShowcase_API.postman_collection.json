	"item": [
		{
			"name": "1 - Profiles (Perfis)",
			"item": [
				{
					"name": "Cadastrar Perfil (POST /api/profiles)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code deve ser 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Deve retornar ID gerado e dados corretos\", function () {",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData.email).to.eql('guilherme.barbosa@example.com');",
									"});",
									"pm.environment.set(\"profile_id\", jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Guilherme Barbosa\",\n  \"email\": \"guilherme.barbosa@example.com\",\n  \"bio\": \"Desenvolvedor Full Stack apaixonado por arquitetura limpa e APIs escaláveis.\",\n  \"github_url\": \"https://github.com/GuilhermeBarbosa556\",\n  \"linkedin_url\": \"https://linkedin.com/in/guilhermebarbosa\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/profiles",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"profiles"
							]
						},
						"description": "Cadastra um novo perfil de desenvolvedor com validação de formato de URL e e-mail único."
					},
					"response": []
				},
				{
					"name": "Buscar Perfil por ID (GET /api/profiles/{id})",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code deve ser 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Deve conter lista de projetos vinculados (1 : N)\", function () {",
									"    pm.expect(jsonData).to.have.property('projects');",
									"    pm.expect(Array.isArray(jsonData.projects)).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/profiles/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"profiles",
								"1"
							]
						},
						"description": "Busca perfil pelo ID com carregamento relacional de seus projetos (1 : N)."
					},
					"response": []
				},
